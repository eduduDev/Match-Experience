generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/match_experience/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("admin")
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Event {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  status       String        @default("waiting")
  createdAt    DateTime      @default(now())
  participants Participant[]
  tables       Table[]
}

model Participant {
  id           String   @id @default(cuid())
  eventId      String
  name         String
  company      String
  offers       String[]
  needs        String[]
  complement   String?
  sessionToken String   @unique
  tableId      String?
  createdAt    DateTime @default(now())
  event        Event    @relation(fields: [eventId], references: [id])
  table        Table?   @relation(fields: [tableId], references: [id])

  @@index([eventId])
  @@index([tableId])
}

model Table {
  id            String        @id @default(cuid())
  eventId       String
  tableNumber   Int
  affinityScore Float         @default(0)
  createdAt     DateTime      @default(now())
  event         Event         @relation(fields: [eventId], references: [id])
  participants  Participant[]

  @@index([eventId])
}
